# Generated RU consumer subset. Owner root:root, mode 0600.
# The RU consumer dials its local SSH forward on 127.0.0.1:24443. That forward
# has the independently validated NL target 127.0.0.1:24444.
WARP_EGRESS_ADDRESS=127.0.0.1
WARP_EGRESS_PORT=24443
WARP_EGRESS_CLIENT_ID=
WARP_EGRESS_NETWORK=raw
WARP_EGRESS_SECURITY=none

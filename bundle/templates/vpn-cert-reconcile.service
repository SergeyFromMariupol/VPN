[Unit]
Description=Reconcile the VPN runtime TLS certificate with Certbot
After=network-online.target certbot.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /var/lib/vpn-installer/bundle/base/reconcile-tls.sh
TimeoutStartSec=5min
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
